{% set root = (ctx.efficiency | float(0)) ** 0.5 %}
{% set needed = namespace(value=0, baseline=0, valid=true) %}
{% for i in range(3) %}
  {% if ctx.soc[i] < 0 or ctx.soc[i] > 100 or ctx.reserve[i] < 3 or ctx.reserve[i] > 100 %}{% set needed.valid=false %}{% endif %}
  {% set needed.value = needed.value + ctx.capacity * ([100 - ctx.soc[i], 0] | max) / 100 %}
  {% set needed.baseline = needed.baseline + ctx.capacity * ([ctx.soc[i] - ctx.reserve[i], 0] | max) / 100 * root %}
{% endfor %}
{% set start = (ctx.now_ts // 900 * 900) | int %}
{% set curve = namespace(rows=[], den_today=0, den_tomorrow=0, solar_surplus=0, daylight_load=0, forecast_used=0) %}
{% for i in range(196) %}
  {% set ts = start + i * 900 %}
  {% set dt = as_local(as_datetime(ts)) %}
  {% set day = dt.date() | string %}
  {% set fraction = ([ts + 900 - ctx.now_ts, 900] | min) / 3600 if i == 0 else 0.25 %}
  {% set daylight = day == ctx.solar_day and ts < ctx.sunset_ts %}
  {% set score = profile.pv[dt.hour] * fraction %}
  {% if day == ctx.today %}{% set curve.den_today = curve.den_today + score %}
  {% elif day == (as_datetime(ctx.today).date() + timedelta(days=1)) | string %}{% set curve.den_tomorrow = curve.den_tomorrow + score %}{% endif %}
  {% set curve.rows=curve.rows + [{'ts':ts,'day':day,'score':score,'load':profile.house[dt.hour] * fraction,'daylight':daylight}] %}
{% endfor %}
{% set solar_rows = namespace(rows=[]) %}
{% for row in curve.rows %}
  {% set solar=0 %}
  {% if row.day == ctx.today and curve.den_today > 0 %}
    {% set solar=ctx.forecast_today * ctx.correction * row.score / curve.den_today %}
  {% elif row.day == (as_datetime(ctx.today).date() + timedelta(days=1)) | string and curve.den_tomorrow > 0 %}
    {% set solar=ctx.forecast_tomorrow * ctx.correction * row.score / curve.den_tomorrow %}
  {% endif %}
  {% if row.daylight %}
    {% set curve.solar_surplus = curve.solar_surplus + ([solar-row.load,0] | max) * root %}
    {% set curve.daylight_load = curve.daylight_load + row.load %}
    {% set curve.forecast_used = curve.forecast_used + solar %}
  {% endif %}
  {% set solar_rows.rows=solar_rows.rows + [dict(row, solar=solar)] %}
{% endfor %}
{% set price_map = namespace(items=[]) %}
{% for p in tariff.get('prices', {}).get('fixture_tariff', []) %}
  {% if p.get('price') is number %}{% set price_map.items = price_map.items + [(as_timestamp(p.start_time, 0) | int, p.price * 100)] %}{% endif %}
{% endfor %}
{% set prices = dict(price_map.items) %}
{% set last_price_ts = (prices.keys() | list | max) if prices else 0 %}
{% set ns = namespace(existing=needed.baseline, delivered=0, value=0, gap=false, internal_gap=false, slots=0) %}
{% set target = needed.value * root %}
{% for row in solar_rows.rows %}
  {% if row.ts > start and ns.delivered < target and not ns.gap %}
    {% if row.ts not in prices %}{% set ns.gap=true %}{% set ns.internal_gap = row.ts <= last_price_ts %}
    {% else %}
      {% set deficit = [row.load-row.solar,0] | max %}
      {% set prior = [ns.existing,deficit] | min %}
      {% set ns.existing = ns.existing-prior %}
      {% set take = [deficit-prior,target-ns.delivered] | min %}
      {% set ns.value = ns.value + take * prices[row.ts] %}
      {% set ns.delivered = ns.delivered + take %}
      {% set ns.slots=ns.slots + 1 %}
    {% endif %}
  {% endif %}
{% endfor %}
{% set forecast_ok = ctx.forecast_today >= 0 and ctx.forecast_tomorrow >= 0 and (curve.den_today > 0 or ctx.forecast_today == 0) and (curve.den_tomorrow > 0 or ctx.forecast_tomorrow == 0) %}
{% set valid = needed.valid and not ns.internal_gap and ctx.capacity > 0 and ctx.efficiency > 0 and ctx.efficiency <= 1 and ctx.correction >= 0 and profile.samples >= 3 and start in prices and ((prices.get(start,999)-ctx.current) | abs < 0.051) and forecast_ok and ctx.sunset_ts > ctx.now_ts %}
{{ {'valid':valid, 'needed':needed.value | round(4), 'solar_surplus':curve.solar_surplus | round(4), 'daylight_load':curve.daylight_load | round(4), 'solar_forecast':curve.forecast_used | round(4), 'avoided_price':(ns.value/ns.delivered) | round(4) if ns.delivered > 0 else 0, 'covered':ns.delivered >= target-0.0001 and target > 0, 'coverage':ns.delivered | round(4), 'target_ac':target | round(4), 'slots':ns.slots, 'price_horizon_end':last_price_ts + 900 if last_price_ts > 0 else 0, 'internal_price_gap':ns.internal_gap} | to_json }}
